# Copy to .env and fill in values (never commit .env):
#   cp .env.example .env
#
# Loaded automatically on startup when run from the repo root.

# Log level: debug | info | warn | error
LOG_LEVEL=info

# SQLite database file (parent directory is created automatically)
DATABASE_PATH=data/easyterms.db

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (logs a security warning at startup).
ALLOWED_TELEGRAM_IDS=

# OpenAI-compatible LLM API (OpenAI, OpenRouter, LM Studio, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
