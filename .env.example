# Copy to .env and fill in values (never commit .env):
#   cp .env.example .env
#
# Loaded automatically on startup when run from the repo root.
#
# Env precedence (highest wins):
#   1. Shell export (e.g. TELEGRAM_PROXY=... before go run)
#   2. Docker Compose `environment:` block (overrides env_file for the same key)
#   3. .env file (godotenv; does not overwrite variables already set in the shell)
#
# For Docker Compose, .env next to docker-compose.yml is usually enough (see env_file).

# Log level: debug | info | warn | error
LOG_LEVEL=info

# SQLite database file (parent directory is created automatically)
DATABASE_PATH=data/easyterms.db

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional SOCKS/HTTP proxy for Telegram Bot API (long polling + sendMessage).
# Leave empty for direct connection. socks5h = DNS resolved on the proxy side.
# TELEGRAM_PROXY=socks5h://user:password@host:port

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (logs a security warning at startup).
ALLOWED_TELEGRAM_IDS=

# OpenAI-compatible LLM API (OpenAI, OpenRouter, LM Studio, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
